# Copilot MCP Servers - Environment Variables
# Copy to .env and fill in your credentials

# GitHub MCP - Repository Management
# Get token at: https://github.com/settings/tokens
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE

# HuggingFace MCP - Model & Dataset Hub  
# Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Kaggle MCP - Dataset Discovery
# Download from: https://www.kaggle.com/settings/account
# Place at: ~/.kaggle/kaggle.json
KAGGLE_CONFIG_DIR=~/.kaggle

# SQLite MCP - Experiment Tracking
# Auto-configured at: data/experiments.db
# No additional setup needed

# Ollama MCP - Local Model Inference
# Should be running on localhost:11434
# Start with: ollama serve
OLLAMA_ENDPOINT=http://localhost:11434
